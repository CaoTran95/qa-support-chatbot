# All optional. Defaults shown.
HERMES_PROFILE=qa-support
HERMES_BIN=hermes
HERMES_TIMEOUT_MS=180000

# --- Remote mode: web on Render, Hermes on a local machine via ngrok ---
# Web (Render) side. If HERMES_BRIDGE_URL is unset, the web spawns the Hermes CLI directly.
# HERMES_BRIDGE_URL=https://your-domain.ngrok-free.app
# HERMES_BRIDGE_TOKEN=<same value as BRIDGE_TOKEN>
# Bridge (local machine) side:
# BRIDGE_TOKEN=<openssl rand -hex 24>
# BRIDGE_PORT=8787

# --- Admin auth bridge (staging only) ---
# Shared secret between this server and the Admin MCP (>=32 chars): openssl rand -hex 32
# QA_INTERNAL_SECRET=
# Community login only on this web (no ECOMMERCE_BASE_URL). Host MUST also be in BIDU_STAGING_HOSTS.
# COMMUNITY_BASE_URL=https://<staging-community-host>
# BIDU_STAGING_HOSTS=<staging-community-host>
# Optional: MCP token cache file (cookies are the source of truth). Default .data/admin-token-store.json.
# ADMIN_TOKEN_STORE_PATH=
